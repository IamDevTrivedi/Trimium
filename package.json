{
    "name": "trimium",
    "version": "0.1.0",
    "description": "Monorepo for Trimium, a full-stack URL shortener, QR generator, and analytics platform.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "scripts": {
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "check": "bun run lint && bun run format:check",
        "prepare": "husky",
        "dev": "bun run ./scripts/dev.js",
        "install:all": "bun run ./scripts/install-all.js",
        "clean:all": "bun run ./scripts/clean-all.js",
        "reset:all": "bun run ./scripts/reset-all.js",
        "download:geoip": "bun --env-file=.env run ./scripts/update-geolite2.js"
    },
    "keywords": [],
    "author": "Dev Trivedi <devtrivedi.work@gmail.com> (https://github.com/IamDevTrivedi)",
    "github": "https://github.com/IamDevTrivedi/Trimium",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IamDevTrivedi/Trimium.git"
    },
    "bugs": {
        "url": "https://github.com/IamDevTrivedi/Trimium/issues"
    },
    "homepage": "https://github.com/IamDevTrivedi/Trimium#readme",
    "packageManager": "bun@1.4.0",
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "husky": "^9.1.7",
        "jiti": "^2.7.0"
    }
}
