{
    "name": "trimium",
    "version": "0.1.0",
    "description": "Monorepo for Trimium, a full-stack URL shortener, QR generator, and analytics platform.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,md}\"",
        "lint": "eslint . --ext .js,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
        "check": "bun run lint && bun run format:check",
        "prepare": "husky",
        "dev": "bun --parallel run --filter trimium-client --filter trimium-server dev",
        "install:all": "bun run ./scripts/install-all.js",
        "clean:all": "bun run ./scripts/clean-all.js",
        "reset:all": "bun run ./scripts/reset-all.js",
        "download:geoip": "bun run ./scripts/update-geolite2.js"
    },
    "keywords": [],
    "author": "Dev Trivedi <devtrivedi.work@gmail.com> (https://github.com/IamDevTrivedi)",
    "github": "https://github.com/IamDevTrivedi/Trimium",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IamDevTrivedi/Trimium.git"
    },
    "bugs": {
        "url": "https://github.com/IamDevTrivedi/Trimium/issues"
    },
    "homepage": "https://github.com/IamDevTrivedi/Trimium#readme",
    "packageManager": "bun@1.4.0",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^10.8.1",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "typescript-eslint": "^8.67.0"
    }
}
