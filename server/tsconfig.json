{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@config/*": ["./src/config/*"],
            "@db/*": ["./src/db/*"],
            "@utils/*": ["./src/utils/*"],
            "@/*": ["./src/*"],
            "@modules/*": ["./src/modules/*"],
            "@middlewares/*": ["./src/middlewares/*"],
            "@constants/*": ["./src/constants/*"],
            "@models/*": ["./src/models/*"]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*"]
}
