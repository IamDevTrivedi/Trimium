printf '%s\n' '[husky][pre-commit] Starting quality checks...'
printf '%s\n' '[husky][pre-commit] Running: bun run check'

if bun run check; then
	printf '%s\n' '[husky][pre-commit] All checks passed. Commit allowed.'
else
	status=$?
	printf '%s\n' "[husky][pre-commit] Checks failed (exit code: $status). Commit blocked."
	exit "$status"
fi